{
    "info": {
        "_postman_id": "b7e3c2a1-4f5d-4e6a-9c8b-1a2b3c4d5e6f",
        "name": "SIHANDAL API v1",
        "description": "SIHANDAL V2 (Sistem Informasi Keuangan Daerah) REST API. Uses environment variables {{base_url}} and {{token}}. Login first; the Tests script stores the token automatically.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "email",
            "value": "admin@example.com"
        },
        {
            "key": "password",
            "value": "password"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const data = pm.response.json();",
                                    "if (data.success && data.data.token) {",
                                    "    pm.collectionVariables.set('token', data.data.token);",
                                    "    pm.test('token saved', () => pm.expect(data.data.token).to.be.a('string'));",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": { "type": "noauth" },
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"postman\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/login",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "auth", "login"]
                        },
                        "description": "Issue a Sanctum bearer token. 5 requests/minute per IP."
                    }
                },
                {
                    "name": "Me",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/me",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "auth", "me"]
                        }
                    }
                },
                {
                    "name": "Refresh",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/refresh",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "auth", "refresh"]
                        },
                        "description": "Revokes the current token and returns a new one."
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/logout",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "auth", "logout"]
                        }
                    }
                }
            ]
